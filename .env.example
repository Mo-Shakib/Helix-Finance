# Copy to .env and adjust if your ports/credentials differ.
# The defaults below match docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://dwh_user:dwh_password@localhost:5433/finance_dwh

POSTGRES_DB=finance_dwh
POSTGRES_USER=dwh_user
POSTGRES_PASSWORD=dwh_password
POSTGRES_PORT=5433

# Optional; defaults to ./data/raw relative to the project root.
# DATA_DIR=./data/raw
